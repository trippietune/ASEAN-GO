# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store

# Release signing — never commit the keystore or its passwords.
# (Exclude specific files rather than the whole dir, so the .example below
# can still be tracked — git won't apply a negation inside an excluded dir.)
android/keystore/*.jks
android/keystore/keystore.properties
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
