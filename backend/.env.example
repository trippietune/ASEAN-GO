NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://asean_go:asean_go_dev@localhost:5433/asean_go

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# OAuth (placeholders until you have real credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Maps
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Firebase Cloud Messaging (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Payments (Omise sandbox keys — see https://dashboard.omise.co/test/keys)
STRIPE_SECRET_KEY=
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# Media uploads (Cloudinary — see https://console.cloudinary.com/settings/api-keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password reset emails (SMTP). Leave blank to log reset links to the
# console instead of sending real emails — useful for local dev.
# Gmail: use an App Password (not your normal password), smtp.gmail.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Browser origins allowed via CORS (comma-separated). Leave unset for local
# dev — any http(s)://localhost:<any port> origin is allowed automatically,
# which covers both the admin dashboard's Vite dev server and Flutter web's
# `flutter run -d chrome` (binds a different random port every launch).
# See .env.production.example for the production behavior.
CORS_ALLOWED_ORIGINS=
