# Production environment template — copy the real values into your deploy
# platform's secret/env store (Railway/Render dashboard), never into a file
# committed to git. This file documents what's required; it holds no secrets.

NODE_ENV=production
PORT=4000

# Supabase: use the Connection Pooler string (Session or Transaction mode),
# NOT the direct "db.<ref>.supabase.co" host — that host is IPv6-only on all
# new Supabase projects and will fail to connect from most container
# platforms (Railway, Render, etc. resolve/route IPv4 by default).
# Find it in: Supabase Dashboard → your project → "Connect" button → pooler tab.
# Shape: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Do NOT wrap the value in quotes here or in any platform's env var UI.
# `dotenv` (local dev) tolerates surrounding quotes and strips them, but
# `docker --env-file` and some platforms take the value literally — a
# quoted value breaks the connection string in a confusing way (verified:
# it produced a bogus host and failed with ENOTFOUND).
DATABASE_URL=

# Generate with: openssl rand -base64 48
# Must NOT be "dev-secret-change-me" — the app refuses to boot in production if it is.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OAuth (leave blank to keep those sign-in methods disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Maps
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Firebase Cloud Messaging (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Payments — Omise LIVE keys (see https://dashboard.omise.co/keys, not /test/keys).
# Requires Omise to have approved the merchant account for live mode first
# (business verification) — see the deployment runbook for that process.
STRIPE_SECRET_KEY=
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# Media uploads (Cloudinary — see https://console.cloudinary.com/settings/api-keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password reset emails (SMTP). If left blank, reset links are only logged
# server-side and never emailed — do NOT ship to production without this set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Browser-based origins allowed to call this API via CORS (comma-separated).
# Only matters for browser clients (the admin dashboard) — the mobile app
# sends no Origin header and is unaffected. REQUIRED in production: with
# NODE_ENV=production and this unset, only https://asean-go.vercel.app is
# allowed by default — set this explicitly if the admin dashboard is ever
# redeployed under a different domain, or to add more allowed origins.
CORS_ALLOWED_ORIGINS=https://asean-go.vercel.app
